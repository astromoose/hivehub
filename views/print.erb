<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Print — Season <%= @zone.season %>: <%= h @zone.name %> — HIVEHUB</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <style>
    @font-face {
      font-family: "Electrolize";
      font-style: normal;
      font-weight: 400;
      src: url("/fonts/electrolize-v20-latin.woff2") format("woff2");
    }
    @page { size: A4 landscape; margin: 10mm; }
    * { box-sizing: border-box; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    body {
      margin: 0 auto; padding: 1.2rem; max-width: 1100px;
      background: #fff; color: #1c1724;
      font-family: "Courier New", Courier, monospace; font-size: 13px;
    }
    h1, h2 { font-family: "Electrolize", "Courier New", monospace; letter-spacing: 0.08em; text-transform: uppercase; }
    h1 { font-size: 1.3rem; margin: 0 0 0.15rem; }
    h2 { font-size: 0.95rem; margin: 1.2rem 0 0.4rem; border-bottom: 2px solid #1c1724; padding-bottom: 0.2rem; }
    .print-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; border-bottom: 3px double #1c1724; padding-bottom: 0.5rem; }
    .print-meta { text-align: right; font-size: 11px; color: #555; white-space: nowrap; }
    .zone-desc { font-style: italic; color: #444; margin: 0.4rem 0 0; }
    #hexmap { display: block; width: 100%; max-height: 60vh; margin: 0.8rem auto 0; }
    .hex { stroke: #2a2233; stroke-width: 2.5; }
    .hex-label { font-family: "Courier New", monospace; font-size: 8.5px; pointer-events: none; }
    .hex-home { font-size: 12px; pointer-events: none; }
    .hex-type { font-size: 6.5px; font-style: italic; pointer-events: none; }
    td .boons { font-size: 10px; color: #555; }
    .legend { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
    .legend li { display: flex; align-items: center; gap: 0.4rem; }
    .swatch { width: 14px; height: 14px; border: 1px solid #2a2233; display: inline-block; }
    .swatch-nml { background: repeating-linear-gradient(-45deg, #fff, #fff 4px, #ddd 4px, #ddd 8px); }
    .legend .sub { color: #555; font-size: 11px; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th, td { border: 1px solid #999; padding: 0.25rem 0.5rem; text-align: left; vertical-align: top; }
    th { background: #eee; font-family: "Electrolize", monospace; text-transform: uppercase; font-size: 10px; letter-spacing: 0.06em; }
    td.owner { white-space: nowrap; }
    .home-mark { font-weight: bold; }
    .print-foot { margin-top: 1rem; font-size: 9px; color: #777; border-top: 1px solid #ccc; padding-top: 0.4rem; }
    .no-print { position: fixed; top: 0.8rem; right: 0.8rem; }
    .no-print button {
      font-family: "Electrolize", monospace; text-transform: uppercase; letter-spacing: 0.08em;
      background: #1c1724; color: #e3d5bd; border: 1px solid #6b9e9d; padding: 0.5rem 1rem; cursor: pointer;
    }
    .gazetteer { break-before: page; }
    @media print {
      .no-print { display: none; }
      body { padding: 0; }
      #hexmap { max-height: none; }
    }
  </style>
</head>
<body>
  <div class="no-print"><button onclick="window.print()">⎙ Print</button></div>

  <header class="print-head">
    <div>
      <h1><%= h @campaign.name %> — Season <%= @zone.season %>: <%= h @zone.name %></h1>
      <p class="zone-desc"><%= h @zone.description %></p>
    </div>
    <div class="print-meta">
      HIVEHUB Guilder Chart<br>
      Printed <%= Time.now.strftime("%Y-%m-%d") %><br>
      <%= @turfs.count { |t| t.gang_id } %>/<%= @turfs.size %> turfs claimed
    </div>
  </header>

  <svg id="hexmap" role="img" aria-label="Zone hexmap"></svg>

  <h2>Chart Key</h2>
  <ul class="legend" id="legend"></ul>

  <section class="gazetteer">
    <h2>Turf Gazetteer</h2>
    <table>
      <thead>
        <tr><th>Turf</th><th>Territory</th><th>Controlled By</th><th>Notes</th></tr>
      </thead>
      <tbody>
        <% gang_names = @gangs.to_h { |g| [g.id, g.name] } %>
        <% @turfs.sort_by(&:name).each do |t| %>
          <tr>
            <td><%= h t.name %></td>
            <td>
              <% if t.territory_type %>
                <strong><%= h t.territory_type %></strong>
                <% boons = Territories.boon_lines(t.territory_type) %>
                <% unless boons.empty? %><br><span class="boons"><%= boons.map { |b| h(b) }.join("<br>") %></span><% end %>
              <% else %>
                —
              <% end %>
            </td>
            <td class="owner">
              <% if t.gang_id %>
                <%= h gang_names[t.gang_id] %><% if t.home_gang_id == t.gang_id %> <span class="home-mark">⌂ home</span><% end %>
              <% else %>
                No-man's-land
              <% end %>
            </td>
            <td><%= h t.description %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>

  <p class="print-foot">
    Necromunda and all associated marks are the intellectual property of Games Workshop Ltd.
    HIVEHUB is an unofficial fan-made tool. Gang icons by Lorc, Delapouite &amp; Carl Olsen (game-icons.net, CC BY 3.0).
  </p>

  <script id="zone-data" type="application/json"><%= @data_json %></script>
  <script src="/js/hexmap-print.js"></script>
</body>
</html>
