<% @title = "Access Terminal" %>
<section class="panel auth-panel">
  <h1>Access Terminal</h1>
  <p class="muted">State your callsign, Arbitrator. The hive is watching.</p>
  <% if @error %><div class="error">✖ <%= h @error %></div><% end %>
  <form method="post" action="/login" class="stacked-form">
    <label>Callsign
      <input type="text" name="username" required autocomplete="username" autofocus>
    </label>
    <label>Passphrase
      <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit" class="btn primary">Jack In</button>
  </form>
  <% if github_enabled? %>
    <div class="divider">or</div>
    <a class="btn github" href="/auth/github">⬡ Authenticate via GitHub</a>
  <% end %>
  <p class="muted small">No credentials? <a href="/register">Petition for access</a>.</p>
</section>

<section class="panel census-panel">
  <h2>Guilder Census</h2>
  <% census = hive_census %>
  <div class="census-grid">
    <div class="census-stat">
      <span class="census-num"><%= census[:arbitrators] %></span>
      <span class="census-label">Arbitrator<%= "s" unless census[:arbitrators] == 1 %></span>
    </div>
    <div class="census-stat">
      <span class="census-num"><%= census[:campaigns] %></span>
      <span class="census-label">Campaign<%= "s" unless census[:campaigns] == 1 %></span>
    </div>
    <div class="census-stat">
      <span class="census-num"><%= census[:gangs] %></span>
      <span class="census-label">Gang<%= "s" unless census[:gangs] == 1 %></span>
    </div>
  </div>
  <p class="muted small census-note">Figures certified by the Merchant Guild. Discrepancies are punishable.</p>
</section>
