<% @title = @campaign.name %>
<section class="panel">
  <div class="breadcrumbs"><a href="/dashboard">Campaigns</a> / <%= h @campaign.name %></div>
  <h1><%= h @campaign.name %></h1>
  <% unless @campaign.description.to_s.empty? %><p class="muted"><%= h @campaign.description %></p><% end %>
</section>

<div class="two-col">
  <section class="panel">
    <h2>Seasons</h2>
    <p class="muted small">Each season charts a new zone of the underhive. Gangs carry over; turf does not.</p>
    <% active, archived = @zones.partition { |z| !z.archived? } %>
    <ul class="card-list">
      <% active.each do |z| %>
        <li class="card">
          <a class="card-title" href="/zones/<%= z.id %>">Season <%= z.season %>: <%= h z.name %></a>
          <p class="muted small"><%= h z.description %></p>
          <div class="card-meta"><%= z.turfs_dataset.count %> turfs · <%= z.turfs_dataset.exclude(gang_id: nil).count %> claimed</div>
          <div class="card-actions">
            <form method="post" action="/zones/<%= z.id %>/archive" class="inline-form">
              <button type="submit" class="btn small-btn">Archive</button>
            </form>
            <form method="post" action="/zones/<%= z.id %>/delete" class="inline-form" onsubmit="return confirm('Purge this season and all its turf from the record? This cannot be undone.')">
              <button type="submit" class="btn danger small-btn">Purge</button>
            </form>
          </div>
        </li>
      <% end %>
      <% if active.empty? %>
        <li class="empty-state">No active season. Chart a new zone below.</li>
      <% end %>
    </ul>
    <form method="post" action="/campaigns/<%= @campaign.id %>/zones">
      <button type="submit" class="btn primary">Chart New Season</button>
    </form>
    <% unless archived.empty? %>
      <h3 class="archive-heading">Archived Seasons</h3>
      <ul class="card-list">
        <% archived.each do |z| %>
          <li class="card archived">
            <a class="card-title" href="/zones/<%= z.id %>">Season <%= z.season %>: <%= h z.name %></a>
            <span class="archive-badge">Archived</span>
            <div class="card-meta"><%= z.turfs_dataset.count %> turfs · <%= z.turfs_dataset.exclude(gang_id: nil).count %> claimed</div>
            <div class="card-actions">
              <form method="post" action="/zones/<%= z.id %>/archive" class="inline-form">
                <button type="submit" class="btn small-btn">Restore</button>
              </form>
              <form method="post" action="/zones/<%= z.id %>/delete" class="inline-form" onsubmit="return confirm('Purge this season and all its turf from the record? This cannot be undone.')">
                <button type="submit" class="btn danger small-btn">Purge</button>
              </form>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section class="panel">
    <h2>Gangs</h2>
    <% if @gangs.empty? %>
      <p class="empty-state">No gangs registered. The zone is all no-man's-land.</p>
    <% else %>
      <ul class="gang-list">
        <% @gangs.each do |g| %>
          <li>
            <span class="swatch" style="background: <%= g.color %>"></span>
            <%= gang_icon_svg(g) %>
            <span class="gang-name"><%= h g.name %></span>
            <span class="muted small"><%= h g.gang_type %></span>
            <% if g.mm_gang_id %>
              <span class="mm-stats small" title="Synced from Munda Manager<%= g.mm_owner ? " (#{h g.mm_owner})" : "" %>">
                ⛓ R:<%= g.mm_rating || "?" %> · ₢<%= g.mm_credits || "?" %> · Rep:<%= g.mm_reputation || "?" %>
              </span>
            <% end %>
            <form method="post" action="/gangs/<%= g.id %>/delete" class="inline-form" onsubmit="return confirm('Strike this gang from the record? Their turf reverts to no-man\'s-land.')">
              <button type="submit" class="link-btn danger-link">✖</button>
            </form>
          </li>
        <% end %>
      </ul>
    <% end %>
    <h3>Register Gang</h3>
    <form method="post" action="/campaigns/<%= @campaign.id %>/gangs" class="stacked-form narrow">
      <label>Gang name
        <input type="text" name="name" required maxlength="60" placeholder="e.g. The Slag Sirens">
      </label>
      <label>Affiliation
        <select name="gang_type" required>
          <% Flavour::GANG_TYPES.each do |t| %>
            <option value="<%= h t %>"><%= h t %></option>
          <% end %>
        </select>
      </label>
      <button type="submit" class="btn primary">Register &amp; Assign Home Turf</button>
    </form>
    <p class="muted small">New gangs are granted a random unclaimed turf on the edge of the current season's map. At least half of every map must remain no-man's-land at claim time.</p>

    <h3>Munda Manager Uplink</h3>
    <% if @campaign.mm_campaign_id %>
      <p class="small">Linked to <strong><%= h(@campaign.mm_campaign_name || @campaign.mm_campaign_id) %></strong>
        <% if @campaign.mm_synced_at %><span class="muted small">(last sync <%= @campaign.mm_synced_at.strftime("%Y-%m-%d %H:%M") %>)</span><% end %>
      </p>
      <div class="card-actions">
        <form method="post" action="/campaigns/<%= @campaign.id %>/munda/import" class="inline-form">
          <button type="submit" class="btn small-btn">Import Gangs</button>
        </form>
        <form method="post" action="/campaigns/<%= @campaign.id %>/munda/sync" class="inline-form">
          <button type="submit" class="btn small-btn">Sync Stats</button>
        </form>
        <form method="post" action="/campaigns/<%= @campaign.id %>/munda/link" class="inline-form">
          <input type="hidden" name="mm_campaign_id" value="">
          <button type="submit" class="btn danger small-btn">Unlink</button>
        </form>
      </div>
    <% else %>
      <form method="post" action="/campaigns/<%= @campaign.id %>/munda/link" class="stacked-form narrow">
        <label>Munda Manager campaign ID
          <input type="text" name="mm_campaign_id" placeholder="e.g. 4a2ab55f-ec68-44ab-9572-e0f68e2450d0" pattern="[0-9a-fA-F\-]{36}">
        </label>
        <button type="submit" class="btn primary">Establish Uplink</button>
      </form>
      <p class="muted small">Paste the UUID from your <a href="https://www.mundamanager.com">mundamanager.com</a> campaign URL (<code>/campaigns/&lt;uuid&gt;</code>). Import pulls each member's gangs; Sync refreshes rating, credits and reputation.</p>
    <% end %>
  </section>
</div>
